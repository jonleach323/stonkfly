# ---- What to run ----------------------------------------------------------
# paper: simulated deploys settled from real rounds, no wallet needed.
# live:  real DeployPublic transactions from the wallet below.
STONKFLY_MODE=paper
STONKFLY_NETWORK=mainnet
STONKFLY_CAPITAL=100        # paper starting balance; also the ceiling for the loss stop (up to 1000)
STONKFLY_STAKE=1            # USDC per round, 1-10
STONKFLY_LOSS_STOP=20       # stop deploying after this USDC drawdown
STONKFLY_DAILY_DEPLOYS=300  # 1-1440
# STONKFLY_NEURAL_MS=500
# STONKFLY_FROZEN=0          # 1 = freeze memory (control run)
# STONKFLY_PRIORITY_FEE=0    # microlamports per compute unit

# ---- Wallet (live mode only) ---------------------------------------------
# Use a DEDICATED wallet funded with only what you are willing to lose and a little SOL for fees.
# Create one with `docker compose run --rm worker keygen --out /runs/satrush-keypair.json` and paste
# the file's 64-number array here (this is what the Docker worker reads):
# SATRUSH_KEYPAIR_JSON=[12,34,...]
# Running outside Docker you may point at the file instead:
# SATRUSH_KEYPAIR=satrush-keypair.json
# Live mode requires both this exact opt-in and STONKFLY_MODE=live.
STONKFLY_LIVE=I_ACCEPT_REAL_DEPLOYS

# ---- Watch page ---------------------------------------------------------
# Bind address for the page on the host (127.0.0.1 keeps it local; 0.0.0.0 exposes it).
STONKFLY_WATCH_BIND=127.0.0.1
STONKFLY_WATCH_PORT=8787
# With `docker compose --profile https up -d`, Caddy serves the page at this domain.
# WATCH_DOMAIN=fly.example.com
# Hosting the page on Vercel? Expose this watch endpoint on a hostname and set STONKFLY_ORIGIN_URL
# on the Vercel project (docs/site.md). Blob publishing below is the alternative for a hidden worker.
# BLOB_READ_WRITE_TOKEN=
# STONKFLY_PUBLISH_PREFIX=stonkfly

# ---- Optional overrides ---------------------------------------------------
# Your own Solana RPC node (mainnet-beta) beats the game's shared endpoint for live play.
# Same host as the containers: http://host.docker.internal:8899
# SATRUSH_RPC_URL=https://rpc.satrush.io
# SATRUSH_API_URL=https://api.satrush.io/api
# STONKFLY_DATA=data
